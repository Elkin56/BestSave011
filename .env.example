# Скопируйте в настройки Vercel (Environment Variables), не коммитьте реальные значения
BOT_TOKEN=123456:ABC-ваш-токен-от-BotFather
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
WEBHOOK_SECRET=любая-случайная-строка

# Публичный адрес проекта — бот подставляет его в ссылки на документы (/privacy).
# Без него команда работает, но вместо ссылок отправляет путь внутри приложения.
PUBLIC_URL=https://ваш-проект.vercel.app

# ── Сообщество ──
# Просто ссылка в интерфейсе и в /invite. Ничего не проверяется и не требуется:
# условия доступа (подписка + приглашения) из проекта убраны.
# Админом канала бот быть больше не обязан.
COMMUNITY_CHAT=@bestsavee
COMMUNITY_TITLE=BestSave Community
# Нужно только для приватного канала: инвайт-ссылка, т.к. числовой id не открыть
# COMMUNITY_URL=https://t.me/+xxxxxxxx

# Владельцы продукта: список tg id через запятую (доступ к панели владельца).
ADMIN_TG_IDS=
